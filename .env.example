# 运行环境：development | production（production 会强制 COS 与 COOKIE_SECURE）
APP_ENV=development
# 至少 32 字符随机值：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 网站共享访问口令（至少 8 位强口令）
APP_PASSWORD=
# 部署平台验收/脚本调用 API 的访问令牌（至少 24 字符），请求头 Authorization: Bearer <ACCESS_TOKEN>
# 生成：python3 -c "import secrets;print(secrets.token_hex(32))"
ACCESS_TOKEN=
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.sqlite

# 对象存储：cos（推荐/生产必需）| local（仅开发）
STORAGE_PROVIDER=cos
COS_REGION=ap-beijing
COS_BUCKET=
COS_PREFIX=ai-mark/
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# 大模型与 ASR（OpenAI 兼容接口）
AI_BASE_URL=https://llm.baifentan.com/openproxy/rp/v1
AI_MODEL=gpt-5.2
AI_API_KEY=
ASR_BASE_URL=https://llm.baifentan.com/openproxy/rp/v1
ASR_MODEL=whisper-1
# 留空则复用 AI_API_KEY
ASR_API_KEY=

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_CONCURRENCY=2
MAX_VIDEO_SECONDS=2400
MAX_IDS_PER_TASK=30

# 内容生产系统
CTP_BASE_URL=https://iot-admin.yukework.com
CTP_COOKIE_TTL_HOURS=24
LOGIN_TIMEOUT_SECONDS=300
MAX_LOGIN_SESSIONS=2

# 安全
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=
